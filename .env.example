# Copy this file to .env and fill in your own keys. NEVER commit .env.

# ---- LLM: choose one provider (gemini | anthropic) ----
LLM_PROVIDER=gemini
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free-tier friendly default; `python run.py --check` verifies the model is available
GEMINI_MODEL=gemini-3.5-flash-lite
# Client-side requests-per-minute throttle (free tier)
GEMINI_RPM=12
# Gemini 3.x thinking level: low | medium | high (leave empty for the model default)
GEMINI_THINKING_LEVEL=low
# Anthropic API key from console.anthropic.com (a Claude chat subscription does not include API credits)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Gnani speech: the ONLY speech-to-text / text-to-speech provider ----
# One key covers STT and TTS: https://app.gnani.ai/voice
GNANI_API_KEY=
# en-IN also accepts Hinglish (Latin script); use hi-IN for Hindi (Devanagari)
GNANI_STT_LANGUAGE=en-IN
# The TTS model is always named explicitly (the SDK default timbre-v2.0 is no longer served)
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE_EN=Kaveri
GNANI_TTS_VOICE_HI=Nalini
GNANI_TTS_VOICE_HINGLISH=Poorvi
# Longer WAV recordings are split into clips of at most this many seconds
GNANI_STT_MAX_SECONDS=30

# ---- Data / retrieval ----
# Optional explicit dataset path (default: ./dataset/Capstone_Project_Dataset_FTTT_2026)
# ZENTROMART_DATASET_DIR=
# auto | fastembed | tfidf (tfidf = clearly labelled lexical fallback)
EMBEDDING_BACKEND=auto
RETRIEVAL_TOP_K=8
